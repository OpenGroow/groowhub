{
  "schemaVersion": 1,
  "adapter": "github",
  "platforms": {
    "github": [
      {
        "key": "branch",
        "label": "Branch (empty: the repository's default branch)",
        "type": "text",
        "placeholder": "main"
      },
      {
        "key": "articlesFolder",
        "label": "Articles folder in the repository",
        "type": "text",
        "placeholder": "apps/web/content/blog",
        "required": true
      },
      {
        "key": "coversFolder",
        "label": "Covers folder in the repository",
        "type": "text",
        "placeholder": "apps/web/public/blog",
        "required": true
      },
      {
        "key": "coversPath",
        "label": "Covers URL path, written in each article's frontmatter",
        "type": "text",
        "placeholder": "/blog",
        "required": true
      },
      {
        "key": "articleBaseUrl",
        "label": "Articles URL on the site",
        "type": "text",
        "placeholder": "https://your-site.com/blog",
        "required": true
      }
    ]
  }
}
