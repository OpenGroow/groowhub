{
  "schemaVersion": 1,
  "adapter": "github",
  "platforms": {
    "github": [
      {
        "key": "branch",
        "label": "Branch (empty: the repository's default branch)",
        "type": "text",
        "placeholder": "main"
      },
      {
        "key": "siteFolder",
        "label": "Folder of the site in the repository (empty: the root)",
        "type": "text",
        "placeholder": "apps/web"
      },
      {
        "key": "articlesFolder",
        "label": "Folder of the articles, in the site (given to createBlogClient)",
        "type": "text",
        "placeholder": "content/blog",
        "required": true
      },
      {
        "key": "coversFolder",
        "label": "Folder of the covers, in the site",
        "type": "text",
        "placeholder": "public/blog",
        "required": true
      },
      {
        "key": "coversPath",
        "label": "URL path of the covers on the site (written in the frontmatter)",
        "type": "text",
        "placeholder": "/blog",
        "required": true
      },
      {
        "key": "articleBaseUrl",
        "label": "URL of the articles",
        "type": "text",
        "placeholder": "https://your-site.com/blog",
        "required": true
      }
    ]
  }
}
